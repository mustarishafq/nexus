{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_all_day": {
      "type": "boolean",
      "default": false
    },
    "series_id": {
      "type": "string"
    },
    "recurrence_frequency": {
      "type": "string",
      "enum": ["daily", "weekly", "monthly"]
    },
    "series_index": {
      "type": "integer"
    },
    "series_share_qr": {
      "type": "boolean",
      "default": false
    },
    "recurrence_month_mode": {
      "type": "string",
      "enum": ["same_day", "first_day", "last_day", "day_of_month"]
    },
    "recurrence_month_day": {
      "type": "integer"
    },
    "recurrence_weekday": {
      "type": "integer"
    },
    "created_by": {
      "type": "string"
    },
    "source_system_id": {
      "type": "string"
    },
    "external_event_id": {
      "type": "string"
    },
    "attendee_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "start_at",
    "end_at"
  ]
}
